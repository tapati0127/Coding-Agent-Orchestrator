# Copy to .env; never commit actual credentials.
# Runtime SDK/API token is required. Use a randomly generated value.
ORCHESTRATOR_TOKEN=
# Optional: leave blank when using only Communicator through the SDK.
# If dashboard is enabled, use a separate token from ORCHESTRATOR_TOKEN.
DASHBOARD_TOKEN=
LANGGRAPH_URL=http://127.0.0.1:2024
QWEN_BASE_URL=http://llm.internal/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-coder
# ChatOpenAI for Communicator and technical Decision passes (OpenAI-compatible).
# Blank values inherit QWEN_*; chat streams, structured Decision output does not.
DECISION_BASE_URL=
DECISION_API_KEY=
DECISION_MODEL=
DECISION_TIMEOUT_SECONDS=120
# Optional verified CA bundle for HTTPS endpoints, including missing intermediates.
# Keep these commented out unless the bundle exists. Compose mounts .local/certs.
# SSL_CERT_FILE=.local/certs/ca-bundle.pem
# NODE_EXTRA_CA_CERTS=.local/certs/ca-bundle.pem
# Optional GitLab context for Analyze's gitlab-cli Work skill.
GITLAB_HOST=
GITLAB_TOKEN=
# Optional override; skill paths are relative to this config file.
WORK_PASS_SKILLS_CONFIG=
MAX_EXECUTE_WORKERS=5
MAX_QWEN_SESSIONS=5
MAX_BACKWARD_DELEGATIONS=3
MAX_TECHNICAL_RETRIES=3
DISPATCH_POLL_SECONDS=2
TASK_LEASE_SECONDS=600
HUMAN_RESPONSE_TIMEOUT_SECONDS=1800
QWEN_TIMEOUT_SECONDS=1800
WORKSPACE_ROOT=/workspace
DATA_ROOT=/data
LANGSMITH_TRACING=false
LANGGRAPH_CLI_NO_ANALYTICS=1
