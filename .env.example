# Copy to .env; never commit actual credentials.

# Qwen/OpenCode: OpenAI-compatible endpoint, including the API prefix.
QWEN_BASE_URL=http://llm.internal/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-coder

# Initialize and structured output; blank values inherit QWEN_*.
DECISION_BASE_URL=
DECISION_API_KEY=
DECISION_MODEL=
# Timeouts, CLI selection and per-role thinking overrides: config/*.yaml.

# GitLab CLI (optional); use a hostname for a self-managed instance.
GITLAB_HOST=
GITLAB_TOKEN=

# Global thinking policy.
LLM_THINKING=false
LLM_THINKING_FORMAT=chat_template_kwargs

# Live logs at /terminals; runtime milestones also go to stderr.
CLI_LOG_DIR=.local/cli-logs
ORCHESTRATOR_LOG_LEVEL=INFO
# ORCHESTRATOR_LOG_FILE=.local/cli-logs/orchestrator.log

# Isolated task worktrees; review and merge locally, without push/MR.
# Target branch must be checked out in a clean Git repository.
GIT_TASK_ISOLATION=true
GIT_TARGET_BRANCH=main
# GIT_WORKTREE_ROOT=/tmp/orchestrator-worktrees

# Compose mounts the project repository from this existing directory.
PROJECT_WORKSPACE=./workspace
# CODER_UID=1000
# CODER_GID=1000
# QWEN_CODE_VERSION=0.26.1
# OPENCODE_VERSION=1.19.4
# GLAB_VERSION=latest

# Host execution only; Compose sets workspace/runtime/CA automatically.
WORKSPACE_ROOT=./workspace
# CODING_CLI_RUNTIME=local
# CODING_CLI_IMAGE=coding-agent-cli:local
# SSL_CERT_FILE=.local/certs/ca-bundle.pem
# NODE_EXTRA_CA_CERTS=.local/certs/ca-bundle.pem
AGENT_WORKDIR_ROOT=./workspace

# Skills default to config/cli/<cli>.yaml; paths inside are relative to YAML.
# QWEN_SKILLS_CONFIG=config/cli/qwen.yaml
# OPENCODE_SKILLS_CONFIG=config/cli/opencode.yaml

LANGSMITH_TRACING=false
LANGGRAPH_CLI_NO_ANALYTICS=1
