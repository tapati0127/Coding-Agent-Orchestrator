# Copy to .env; never commit actual credentials.
# Runtime SDK/API token is required. Use a randomly generated value.
ORCHESTRATOR_TOKEN=
LANGGRAPH_URL=http://127.0.0.1:2024
QWEN_BASE_URL=http://llm.internal/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-coder
# ChatOpenAI for Initialize conversation and all structured passes (OpenAI-compatible).
# Blank values inherit QWEN_*; natural chat streams, structured calls use no_stream.
DECISION_BASE_URL=
DECISION_API_KEY=
DECISION_MODEL=
DECISION_TIMEOUT_SECONDS=120
# Optional verified CA bundle for HTTPS endpoints, including missing intermediates.
# Keep these commented out unless the bundle exists. Compose mounts .local/certs.
SSL_CERT_FILE=.local/certs/ca-bundle.pem
NODE_EXTRA_CA_CERTS=.local/certs/ca-bundle.pem
# Optional GitLab context for Analyze's gitlab-cli Work skill.
GITLAB_HOST=
GITLAB_TOKEN=
# Optional override; skill paths are relative to this config file.
WORK_PASS_SKILLS_CONFIG=
# graph.py: Communicator in the main process; Dispatcher and technical graphs in child processes.
# Queues use Python multiprocessing (spawn).
MAX_EXECUTE_WORKERS=5
MAX_QWEN_SESSIONS=5
MAX_BACKWARD_DELEGATIONS=3
MAX_TECHNICAL_RETRIES=3
DISPATCH_POLL_SECONDS=2
TASK_LEASE_SECONDS=600
HUMAN_RESPONSE_TIMEOUT_SECONDS=1800
QWEN_TIMEOUT_SECONDS=1800
# Optional: defaults to the process working directory when unset.
WORKSPACE_ROOT=
DATA_ROOT=/data
LANGSMITH_TRACING=false
LANGGRAPH_CLI_NO_ANALYTICS=1

# Optional parent for disposable coding CLI workdirs; default: system temp.
# AGENT_WORKDIR_ROOT=/tmp/orchestrator-agents

# Compose runs LangGraph and both CLIs in one container; it forces local runtime.
CODING_CLI_RUNTIME=local
CODING_CLI_IMAGE=coding-agent-cli:local

# Optional Compose workspace on the host (default: current repository).
# PROJECT_WORKSPACE=.
# CODER_UID=1000
# CODER_GID=1000
